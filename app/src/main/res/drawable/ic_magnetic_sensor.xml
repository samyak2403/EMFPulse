<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Magnetic Field Loops / Flux Waves (Shifted down to prevent top clipping) -->
    <path
        android:strokeWidth="3"
        android:strokeColor="#F99797"
        android:strokeLineCap="round"
        android:strokeAlpha="0.9"
        android:pathData="M 38,32 C 46,20 74,20 82,32" />

    <path
        android:strokeWidth="2.5"
        android:strokeColor="#58A6FF"
        android:strokeLineCap="round"
        android:strokeAlpha="0.65"
        android:pathData="M 32,24 C 43,10 77,10 88,24" />

    <path
        android:strokeWidth="2"
        android:strokeColor="#F99797"
        android:strokeLineCap="round"
        android:strokeAlpha="0.4"
        android:pathData="M 26,16 C 40,0 80,0 94,16" />

    <!-- Magnet U-Body (True semicircular inner/outer arcs for a clean curve) -->
    <path
        android:fillColor="#27272A"
        android:strokeColor="#3F3F46"
        android:strokeWidth="2"
        android:pathData="M 26,56 L 26,74 A 34,34 0 0,0 94,74 L 94,56 L 74,56 L 74,74 A 14,14 0 0,1 46,74 L 46,56 Z" />

    <!-- North Pole (Left Cap - Coral / Rose, width matched to 20dp leg) -->
    <path
        android:fillColor="#F99797"
        android:pathData="M 26,40 A 5,5 0 0,1 31,35 L 41,35 A 5,5 0 0,1 46,40 L 46,56 L 26,56 Z" />

    <!-- South Pole (Right Cap - Blue, width matched to 20dp leg) -->
    <path
        android:fillColor="#339AF0"
        android:pathData="M 74,40 A 5,5 0 0,1 79,35 L 89,35 A 5,5 0 0,1 94,40 L 94,56 L 74,56 Z" />

    <!-- Letter 'N' on North Pole (Centered at X=36, Y=41..50) -->
    <path
        android:strokeColor="#18181B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 33,50 L 33,41 L 39,50 L 39,41" />

    <!-- Letter 'S' on South Pole (Aligned to match 'N' height at Y=41..50) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 87,42.5 C 87,40.5 81,40.5 81,43.2 C 81,45.8 87,45.2 87,47.8 C 87,50.5 81,50.5 81,48.5" />

    <!-- Center Sensor Indicator Dot (Slightly larger for better visibility) -->
    <path
        android:fillColor="#FCC419"
        android:pathData="M 60,72 m -4.5,0 a 4.5,4.5 0 1,0 9,0 a 4.5,4.5 0 1,0 -9,0" />
</vector>